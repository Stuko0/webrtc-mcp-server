{
  "name": "webrtc-mcp-server",
  "version": "0.4.0",
  "description": "WebRTC MCP Server — peer-to-peer multi-agent communication, room-based signaling, and video stream bridging via low-latency DataChannels.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "fmt": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "lint": "eslint src/ test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@roamhq/wrtc": "^0.10.0",
    "debug": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "nanoid": "^5.1.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "webrtc",
    "mcp",
    "agent",
    "signaling",
    "realtime",
    "datachannel",
    "p2p"
  ],
  "license": "MIT"
}
